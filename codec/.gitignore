# ==============================================================================
# Rust .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Cargo / build artifacts
# ------------------------------------------------------------------------------
# Main build output directory
target/

# Remove Cargo.lock for libraries, keep it for binaries/executables.
# See https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control-but-not-libraries
# Uncomment the next line if this project is a LIBRARY:
# Cargo.lock

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# ------------------------------------------------------------------------------
# Backup / temporary files
# ------------------------------------------------------------------------------
# Generated by cargo fix
**/*.rs.bk
*.tmp
*.bak
*.orig

# ------------------------------------------------------------------------------
# Testing / coverage / fuzzing / profiling
# ------------------------------------------------------------------------------
# Tarpaulin / llvm-cov coverage reports
tarpaulin-report.*
lcov.info
coverage/
*.profraw
*.profdata
cobertura.xml

# cargo-fuzz (libfuzzer) corpora and artifacts
fuzz/corpus/
fuzz/artifacts/

# Proptest failure persistence
proptest-regressions/

# flamegraph / perf profiling output
flamegraph.svg
perf.data
perf.data.old
*.svg.folded

# Benchmark results (criterion)
criterion/

# ------------------------------------------------------------------------------
# Secrets / environment
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------------------------
# JetBrains (CLion / RustRover / IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# VS Code (keep shared settings if you want; uncomment to ignore everything)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
# .vscode/

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Operating system files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.Trash-*

# ------------------------------------------------------------------------------
# Misc tooling
# ------------------------------------------------------------------------------
# rustfmt / clippy local caches
.rustfmt.toml.local

# cross / docker leftovers
.container-*

# Node (if the project has a JS/WASM component)
node_modules/

# Python (if using pyo3 / maturin bindings)
__pycache__/
*.py[cod]
.venv/

# Log files
*.log

/target
/certs
*.pem

# configurations
.env
config.yaml
